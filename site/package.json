{
  "name": "new-grad-jobs-site",
  "private": true,
  "version": "1.0.0",
  "description": "NGJ terminal job board (Vite + React) served at jobs.riteshrana.engineer",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:fixtures": "NGJ_SEO_DATA_DIR=test/fixtures vite build && node scripts/copy-fixtures.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "fetch-data": "node scripts/fetch-data.mjs",
    "og-image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
